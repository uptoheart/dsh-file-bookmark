{
  "name": "dsh-file-bookmark",
  "version": "0.1.1",
  "description": "dsh-file-bookmark — a DeepSeek Harness plugin (tool template).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "repository": { "type": "git", "url": "git+https://github.com/uptoheart/dsh-file-bookmark.git" },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/wrap-client.mjs && node -e \"require('fs').copyFileSync('src/ui.html','dist/ui.html')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}